{% if (data is defined) and (action is defined) %}
    {% set totalPages = data.meta.totalPages %}
    {% if totalPages is not null %}
    <div class="d-flex flex-column">
        <small class="mb-2 text-center">
            {{ data.meta.totalResults }} - {{ 'Page'|trans }} {{ data.meta.page }} {{ 'of'|trans }} {{ data.meta.totalPages }}
        </small>
        {% if data.meta.totalPages > 1 %}
            <nav aria-label="Page navigation" class="m-auto text-center d-inline">
                <ul class="pagination pagination-sm">
                    {% if (data.meta.page > 1) and (data.meta.totalPages > 5) %}
                        <li class="page-item">
                            <a data-action="{{ action.name }}" title="{{ 'first page'|trans }}" href="{{ generatePathByAction(action, params|default({})|merge({page: 1})) }}" class="page-link">
                                &laquo;
                            </a>
                        </li>
                    {% endif %}
                    {% for page in data.meta.links %}
                        <li class="page-item{% if page == data.meta.page %} active{% endif %}">
                            <a data-action="{{ action.name }}" href="{{ generatePathByAction(action, params|default({})|merge({page: page})) }}" class="page-link">{{ page }}</a>
                        </li>
                    {% endfor %}
                    {% if (data.meta.page < totalPages) and (totalPages > 5) %}
                        <li class="page-item">
                            <a data-action="{{ action.name }}" title="{{ 'last page'|trans }}" href="{{ generatePathByAction(action, params|default({})|merge({page: totalPages})) }}" class="page-link">
                                &raquo;
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    </div>
    {% endif %}
{% endif %}
